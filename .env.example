JWT_SECRET=dev-secret-ganti-di-production
JWT_EXP_HOURS=72
PORT=5000

# Supabase (PostgreSQL) — ambil dari Settings > Database di dashboard Supabase
DB_HOST=db.xxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=postgres
DB_SSL_MODE=require

# Untuk lokal XAMPP (MySQL) — komentar baris Supabase, uncomment ini:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=kreativa
# DB_SSL_MODE=disabled